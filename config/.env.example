# xAI Grok API 設定
# 複製本檔為 config/.env 後填入(套件根目錄的 .env 也會被讀取)
# API Key 從 https://console.x.ai → API Keys 建立取得
XAI_API_KEY=<paste-your-key-here>

# API Server 位置(預設即可,除非 xAI 另行公告)
# XAI_API_URL=https://api.x.ai/v1

# ----------------------------------------------------------------------
# 影片輸出儲存(只有 Zero Data Retention 團隊帳號需要)
# ----------------------------------------------------------------------
# 一般帳號請整段留空 —— 影片照常由 xAI 代管下載網址,行為不變。
#
# 若 xAI 團隊開了 ZDR,影片節點會回:
#   "Zero Data Retention teams must provide output.upload_url"
# 此時二選一:
#   (A) 到 https://console.x.ai 關閉該 team 的 ZDR
#       (ZDR 是 team 層級,無法只對單一 API key 關閉)
#   (B) 自備 S3 相容儲存並填以下設定。xAI 會把影片 PUT 進你的 bucket,
#       自己不留副本;金鑰只用於本機簽章,不會送給 xAI。
#
# off(預設) / s3 / static
# XAI_OUTPUT_STORAGE=s3

# --- s3 模式(AWS S3 / Cloudflare R2 / MinIO)---
# R2 範例:https://<帳號ID>.r2.cloudflarestorage.com
# XAI_OUTPUT_S3_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
# XAI_OUTPUT_S3_BUCKET=grok-video-output
# R2 填 auto;AWS S3 要填實際 region(如 ap-northeast-1)
# XAI_OUTPUT_S3_REGION=auto
# XAI_OUTPUT_S3_ACCESS_KEY_ID=
# XAI_OUTPUT_S3_SECRET_ACCESS_KEY=
# 物件路徑前綴,每支影片存成 <prefix><日期>/<uuid>.mp4
# XAI_OUTPUT_S3_KEY_PREFIX=grok-video/
# 單次網址有效秒數(60~3600,預設 900)
# XAI_OUTPUT_S3_EXPIRES_SECS=900
# R2 / MinIO 用 path-style(預設 true);AWS S3 要 virtual-host 時設 false
# XAI_OUTPUT_S3_FORCE_PATH_STYLE=true

# --- static 模式(單次測試用)---
# 直接給一組已簽好的網址。重複生成會互相覆蓋,正式用途請走 s3。
# XAI_OUTPUT_STORAGE=static
# XAI_OUTPUT_UPLOAD_URL=
# XAI_OUTPUT_FETCH_URL=
